# Use an allowlist so local configuration and credentials never enter the build
# context. The production image and the adapter/panel images are all built from
# this repository root context (see deploy/docker/*.Dockerfile).
**
!CMakeLists.txt
!cmake/
!cmake/**
!core/
!core/**
!proto/
!proto/**
!infrastructure/
!infrastructure/**
!control/
!control/**
!adapters/
!adapters/nonebot/
!adapters/nonebot/**
!panel/
!panel/**
!api/
!api/**
# The build stage installs C++ dependencies from the locked architecture
# manifest, so the allowlist must carry the manifest and its smoke target.
!dependencies/
!dependencies/architecture/
!dependencies/architecture/**
!deploy/
!deploy/docker/
!deploy/docker/**
!sdk/
!sdk/python/
!sdk/python/pyproject.toml
!sdk/python/uv.lock
!sdk/python/tools/
!sdk/python/tools/generate_proto.py
!scripts/
!scripts/deploy/
!scripts/deploy/*.sh
**/.env
**/.env.*
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/.ssh/**
**/secrets/**
**/*token*
**/*TOKEN*
**/*api_key*
**/*API_KEY*
**/node_modules
**/.venv
**/generated
**/dist
# CMake configures both crypto targets when generating the suite build.
!infrastructure/identity_crypto/src/token_crypto.cpp
!infrastructure/identity_crypto/tests/token_crypto_test.cpp
