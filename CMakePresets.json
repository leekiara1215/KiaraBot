{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "KiaraBot development",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "KIARABOT_GENERATE_PROTO": "OFF"
      }
    },
    {
      "name": "proto",
      "inherits": "dev",
      "displayName": "KiaraBot development with protocol generation",
      "binaryDir": "${sourceDir}/build/proto",
      "cacheVariables": { "KIARABOT_GENERATE_PROTO": "ON" }
    },
    {
      "name": "full",
      "inherits": "proto",
      "displayName": "KiaraBot full checks (protocol + infrastructure + compile database)",
      "binaryDir": "${sourceDir}/build/full",
      "cacheVariables": {
        "KIARABOT_ENABLE_INFRASTRUCTURE": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "full-locked",
      "inherits": "full",
      "displayName": "Architecture dependencies (requires pinned VCPKG_ROOT)",
      "binaryDir": "${sourceDir}/build/full-locked",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "Python3_EXECUTABLE": "${sourceDir}/sdk/python/.venv/bin/python",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/dependencies/architecture",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/architecture-installed"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "proto", "configurePreset": "proto" },
    { "name": "full", "configurePreset": "full" },
    { "name": "full-locked", "configurePreset": "full-locked" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "proto", "configurePreset": "proto", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "full", "configurePreset": "full", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "full-locked", "configurePreset": "full-locked", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
