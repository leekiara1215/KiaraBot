# Templates in /etc/nginx/templates are expanded by the nginx image entrypoint.
# NGINX_ENVSUBST_FILTER=KIARABOT_ keeps nginx's own $variables untouched.
server {
    listen 127.0.0.1:${KIARABOT_PANEL_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Process liveness only (static frontend is loaded and served).
    location = /health/live {
        default_type application/json;
        return 200 '{"state":"HEALTHY"}';
    }

    # Panel readiness follows control API readiness; the static server itself
    # does not need QQ/NapCat to be online.
    location = /health/ready {
        proxy_pass http://${KIARABOT_CONTROL_HOST}:${KIARABOT_CONTROL_PORT}/health/ready;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }

    location /api/ {
        proxy_pass http://${KIARABOT_CONTROL_HOST}:${KIARABOT_CONTROL_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 60s;
    }

    location /ws/ {
        proxy_pass http://${KIARABOT_CONTROL_HOST}:${KIARABOT_CONTROL_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
