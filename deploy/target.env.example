# Target deployment environment template (P14a-2). Copy to deploy/target.env (0600)
# and adjust. Never commit real values. Docker Compose interpolation reads this file
# (--env-file), while secrets/config/TLS remain file mounts, not env-in-image.
#
# P14a-2 defaults: single-host Docker Compose (deploy/compose.target.yml), official
# PostgreSQL image postgres:16.4-bookworm (P00 reproduction), read-only file mounts for
# secrets. Two-host is optional/deferred; cross-host fault drills are not validated.
COMPOSE_PROJECT_NAME=kiarabot-target
KIARABOT_VERSION=dev
# Target single-host profile: "exec" runs Plugin Host + Adapter together. Optional
# two-host split uses "host" and "adapter" profiles from deploy/compose.exec.yml.
KIARABOT_TARGET_PROFILE=exec
UBUNTU_BASE=ubuntu:24.04
# Official PG16.4 image reproduces P00. Release/pinned production MUST use a digest, e.g.
# POSTGRES_IMAGE=postgres:16.4-bookworm@sha256:<64 hex>; release smoke enforces it.
POSTGRES_IMAGE=postgres:16.4-bookworm

# Host-side material root (compose.infra/core/exec defaults point here).
KIARABOT_CONFIG_DIR=./target/config
KIARABOT_TLS_DIR=./target/tls
# Secrets material root and optional manifest (file names/modes/consumers/rotation order).
# Default is read-only file mounts; Docker secrets are an optional override
# (deploy/compose.docker-secrets.yml) and require matching config paths under /run/secrets.
KIARABOT_SECRETS_MODE=files
KIARABOT_SECRETS_DIR=./target/secrets
KIARABOT_SECRETS_MANIFEST=./deploy/secrets.manifest.example
KIARABOT_HOST_PACKAGES_DIR=./target/packages
KIARABOT_HOST_DATA_DIR=./target/data/host
KIARABOT_PG_TLS_DIR=./target/tls/postgres
KIARABOT_PG_BACKUP_DIR=./target/backups/postgres
KIARABOT_PG_SUPERUSER_PASSWORD_FILE=./target/secrets/postgres-superuser.pass
KIARABOT_ADAPTER_BOOTSTRAP_FILE=./target/secrets/adapter.bootstrap
KIARABOT_ONEBOT_TOKEN_FILE=./target/secrets/onebot-access-token
# Optional per-file paths for both file mounts and /run/secrets aliases.
# Uncomment only to override an individual file under KIARABOT_SECRETS_DIR.
# KIARABOT_IDENTITY_RUNTIME_PASSWORD_FILE=./target/secrets/identity-runtime.pass
# KIARABOT_IDENTITY_TOKEN_FILE=./target/secrets/token.hex
# KIARABOT_IDENTITY_REQUEST_FILE=./target/secrets/request.hex
# KIARABOT_IDENTITY_RECEIPT_FILE=./target/secrets/receipt.hex
# KIARABOT_IDENTITY_VERIFICATION_KEY_FILE=./target/secrets/delegation.pem
# KIARABOT_IDENTITY_SIGNING_KEY_FILE=./target/secrets/delegation.key
# KIARABOT_RUNTIME_RUNTIME_PASSWORD_FILE=./target/secrets/runtime-runtime.pass
# KIARABOT_SCHEDULER_RUNTIME_PASSWORD_FILE=./target/secrets/scheduler-runtime.pass
# KIARABOT_MODEL_RUNTIME_PASSWORD_FILE=./target/secrets/model-runtime.pass
# KIARABOT_MODEL_ROOT_KEY_FILE=./target/secrets/model-root-key.hex
# KIARABOT_IDENTITY_MIGRATION_PASSWORD_FILE=./target/secrets/identity-migration.pass
# KIARABOT_RUNTIME_MIGRATION_PASSWORD_FILE=./target/secrets/runtime-migration.pass
# KIARABOT_SCHEDULER_MIGRATION_PASSWORD_FILE=./target/secrets/scheduler-migration.pass
# KIARABOT_MODEL_MIGRATION_PASSWORD_FILE=./target/secrets/model-migration.pass
# KIARABOT_ADMIN_PASSWORD_FILE=./target/secrets/admin.pass

# Image references (all default to the local `dev` build; release replaces every one,
# including POSTGRES_IMAGE, with immutable digests and a non-dev KIARABOT_VERSION).
KIARABOT_IDENTITY_IMAGE=ghcr.io/leekiara1215/kiarabot/identity:dev
KIARABOT_RUNTIME_IMAGE=ghcr.io/leekiara1215/kiarabot/runtime:dev
KIARABOT_SCHEDULER_IMAGE=ghcr.io/leekiara1215/kiarabot/scheduler:dev
KIARABOT_MODEL_IMAGE=ghcr.io/leekiara1215/kiarabot/model:dev
KIARABOT_CONTROL_IMAGE=ghcr.io/leekiara1215/kiarabot/control:dev
KIARABOT_PLUGIN_HOST_IMAGE=ghcr.io/leekiara1215/kiarabot/plugin-host:dev
KIARABOT_PANEL_IMAGE=ghcr.io/leekiara1215/kiarabot/panel:dev
KIARABOT_ADAPTER_IMAGE=ghcr.io/leekiara1215/kiarabot/adapter-nonebot:dev
KIARABOT_TOOLS_IMAGE=ghcr.io/leekiara1215/kiarabot/tools:dev

# Dev single-host ports (loopback publish only; two-host prod keeps these private).
KIARABOT_PG_PORT=5432
KIARABOT_IDENTITY_GRPC_PORT=7441
KIARABOT_RUNTIME_GRPC_PORT=7442
KIARABOT_RUNTIME_BRIDGE_PORT=7443
KIARABOT_SCHEDULER_GRPC_PORT=7444
KIARABOT_MODEL_GRPC_PORT=7445
KIARABOT_HOST_GRPC_PORT=7446
KIARABOT_IDENTITY_PROBE_PORT=9081
KIARABOT_RUNTIME_PROBE_PORT=9082
KIARABOT_SCHEDULER_PROBE_PORT=9083
KIARABOT_MODEL_PROBE_PORT=9084
KIARABOT_HOST_PROBE_PORT=9085
KIARABOT_CONTROL_PORT=8080
KIARABOT_CONTROL_PROBE_PORT=9080
KIARABOT_PANEL_PORT=8082
KIARABOT_ADAPTER_HEALTH_PORT=8081

# Execution plane. On a single dev host these can point at localhost; in the
# two-host topology BRIDGE_ENDPOINT points at host-A and BRIDGE_SERVER_NAME must be
# covered by the Runtime bridge certificate SAN.
KIARABOT_BRIDGE_ENDPOINT=runtime:7443
KIARABOT_BRIDGE_SERVER_NAME=runtime
KIARABOT_ADAPTER_INSTANCE_ID=REPLACE_WITH_ADAPTER_INSTANCE_ID
KIARABOT_ADAPTER_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
# Real QQ uses the platform numeric ID independently of the Runtime account UUID.
ONEBOT_SELF_ID=
# Set an address reachable from inside the adapter container.
ONEBOT_WS_URL=ws://127.0.0.1:3001/

# P14a-2 user-confirmed topology: single-host Compose is the default; two-host is
# optional and deferred (cross-host disconnect/reconnect drills are not validated).
# See deploy/README.md and doc/08-operations.md's P14a-2 section.
