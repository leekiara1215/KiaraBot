# Target deployment environment template (P14a). Copy to deploy/target.env (0600)
# and adjust. Never commit real values. Docker Compose interpolation reads this file
# (--env-file), while secrets/config/TLS remain file mounts, not env-in-image.
COMPOSE_PROJECT_NAME=kiarabot-target
KIARABOT_VERSION=dev
UBUNTU_BASE=ubuntu:24.04
POSTGRES_IMAGE=postgres:16.4-bookworm

# Host-side material root (compose.infra/core/exec defaults point here).
KIARABOT_CONFIG_DIR=./target/config
KIARABOT_TLS_DIR=./target/tls
KIARABOT_SECRETS_DIR=./target/secrets
KIARABOT_HOST_PACKAGES_DIR=./target/packages
KIARABOT_HOST_DATA_DIR=./target/data/host
KIARABOT_PG_TLS_DIR=./target/tls/postgres
KIARABOT_PG_BACKUP_DIR=./target/backups/postgres
KIARABOT_PG_SUPERUSER_PASSWORD_FILE=./target/secrets/postgres-superuser.pass
KIARABOT_ADAPTER_BOOTSTRAP_FILE=./target/secrets/adapter.bootstrap
KIARABOT_ONEBOT_TOKEN_FILE=./target/secrets/onebot-access-token

# Image references (all default to the local `dev` build; release replaces them with
# immutable digests and KIARABOT_VERSION).
KIARABOT_IDENTITY_IMAGE=ghcr.io/leekiara1215/kiarabot/identity:dev
KIARABOT_RUNTIME_IMAGE=ghcr.io/leekiara1215/kiarabot/runtime:dev
KIARABOT_SCHEDULER_IMAGE=ghcr.io/leekiara1215/kiarabot/scheduler:dev
KIARABOT_MODEL_IMAGE=ghcr.io/leekiara1215/kiarabot/model:dev
KIARABOT_CONTROL_IMAGE=ghcr.io/leekiara1215/kiarabot/control:dev
KIARABOT_PLUGIN_HOST_IMAGE=ghcr.io/leekiara1215/kiarabot/plugin-host:dev
KIARABOT_PANEL_IMAGE=ghcr.io/leekiara1215/kiarabot/panel:dev
KIARABOT_ADAPTER_IMAGE=ghcr.io/leekiara1215/kiarabot/adapter-nonebot:dev
KIARABOT_TOOLS_IMAGE=ghcr.io/leekiara1215/kiarabot/tools:dev

# Dev single-host ports (loopback publish only; two-host prod keeps these private).
KIARABOT_PG_PORT=5432
KIARABOT_IDENTITY_GRPC_PORT=7441
KIARABOT_RUNTIME_GRPC_PORT=7442
KIARABOT_RUNTIME_BRIDGE_PORT=7443
KIARABOT_SCHEDULER_GRPC_PORT=7444
KIARABOT_MODEL_GRPC_PORT=7445
KIARABOT_HOST_GRPC_PORT=7446
KIARABOT_IDENTITY_PROBE_PORT=9081
KIARABOT_RUNTIME_PROBE_PORT=9082
KIARABOT_SCHEDULER_PROBE_PORT=9083
KIARABOT_MODEL_PROBE_PORT=9084
KIARABOT_HOST_PROBE_PORT=9085
KIARABOT_CONTROL_PORT=8080
KIARABOT_CONTROL_PROBE_PORT=9080
KIARABOT_PANEL_PORT=8082
KIARABOT_ADAPTER_HEALTH_PORT=8081

# Execution plane. On a single dev host these can point at localhost; in the
# two-host topology BRIDGE_ENDPOINT points at host-A and BRIDGE_SERVER_NAME must be
# covered by the Runtime bridge certificate SAN.
KIARABOT_BRIDGE_ENDPOINT=runtime:7443
KIARABOT_BRIDGE_SERVER_NAME=runtime
KIARABOT_ADAPTER_INSTANCE_ID=REPLACE_WITH_ADAPTER_INSTANCE_ID
KIARABOT_ADAPTER_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
ONEBOT_WS_URL=ws://127.0.0.1:3001/

# Two-host topology is documented but NOT user-confirmed yet; see
# reports/analysis/p14-deployment-change-proposal.md §1.2 and deploy/README.md.
