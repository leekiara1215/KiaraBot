# KiaraBot deployment environment template.
#
#   cp deploy/env.example deploy/.env
#   chmod 600 deploy/.env
#   edit every value; never commit deploy/.env
#
# This file is read by Docker Compose as the project env file (interpolation)
# and, because both compose files declare
#   env_file: { path: ${KIARABOT_ENV_FILE:-.env} }
# it is also injected into the core/migrate/adapter containers. The systemd unit
# additionally reads /etc/kiarabot/production.env: use that file for host-side
# values (image references, ports) or point KIARABOT_ENV_FILE at a single file.
#
# Permission errors: core reads KIARABOT_CONTROL_CONFIG (container path
# /etc/kiarabot/control.json) with O_NOFOLLOW and requires a regular file that
# is owned by the container user (uid 10001) and mode 0600.

# --- Core runtime -----------------------------------------------------------
KIARABOT_RUNTIME_DB=/var/lib/kiarabot/kiarabot.db
# Comma-separated list of authorized platform account ids (digits).
KIARABOT_ADAPTER_ACCOUNTS=100000000
# Core bridge credentials; must match the adapter's ADAPTER_ID / CORE_AUTH_TOKEN.
KIARABOT_ADAPTER_ID=nonebot
KIARABOT_ADAPTER_TOKEN=replace-with-a-long-random-token
# Optional single managed plugin (see doc/08 "T03b 受管 Python 插件").
# KIARABOT_PLUGIN_ID=event-observer
# KIARABOT_PLUGIN_TOKEN=replace-with-a-long-random-token
# KIARABOT_PLUGIN_PERMISSIONS=message.read
# Optional model provider (all three required together).
# KIARABOT_MODEL_ENDPOINT=https://api.example.com/v1/chat/completions
# KIARABOT_MODEL_API_KEY=replace-me
# KIARABOT_MODEL_NAME=example-model
# Optional runtime limits (defaults shown; invalid values abort startup).
# KIARABOT_EVENT_QUEUE_LIMIT=1024
# KIARABOT_AUDIT_LIMIT=100000
# KIARABOT_ACTION_LIMIT=10000
# KIARABOT_ACK_TIMEOUT_MS=30000
# KIARABOT_MAINTENANCE_INTERVAL_MS=60000
# KIARABOT_RETENTION_HOURS=168
# Outbound Action quota (process-local sliding windows; restart resets them).
# KIARABOT_ACTION_ACCOUNT_LIMIT_PER_MINUTE=10
# KIARABOT_ACTION_GROUP_LIMIT_PER_MINUTE=3
# KIARABOT_ACTION_PRIVATE_LIMIT_PER_10_SECONDS=1
# Persistent daily budgets for dangerous actions, e.g.:
# KIARABOT_ACTION_DAILY_LIMITS=action.mute_member.v1=20,action.kick_member.v1=5
# Conversation allowlist for dangerous actions (required for mute/kick in
# production; unlisted target conversations are denied by Core), e.g.:
# KIARABOT_ACTION_ALLOWED_CONVERSATIONS=action.mute_member.v1=123456789,action.kick_member.v1=123456789

# --- Control API ------------------------------------------------------------
# Container path of the mounted control configuration; the "listen" field
# inside it must match KIARABOT_CONTROL_PORT.
KIARABOT_CONTROL_CONFIG=/etc/kiarabot/control.json
KIARABOT_CONTROL_PORT=8080

# --- Ports (single-host deployment; all bind 127.0.0.1 only) ----------------
KIARABOT_GRPC_PORT=50051
KIARABOT_ADAPTER_HEALTH_PORT=8081
KIARABOT_PANEL_PORT=8082

# --- NoneBot adapter --------------------------------------------------------
CORE_GRPC_ENDPOINT=127.0.0.1:50051
CORE_AUTH_TOKEN=replace-with-the-same-value-as-KIARABOT_ADAPTER_TOKEN
ADAPTER_ID=nonebot
ACCOUNT_ID=100000000
ONEBOT_WS_URL=ws://127.0.0.1:3001/
ONEBOT_ACCESS_TOKEN=replace-with-napcat-access-token
OUTBOX_PATH=/var/lib/kiarabot-adapter/outbox.db
HEALTH_PORT=8081

# --- Image references -------------------------------------------------------
# staging compose also defines build sections; production requires digests.
# KIARABOT_CORE_IMAGE=ghcr.io/leekiara1215/kiarabot-core@sha256:<64 hex>
# KIARABOT_ADAPTER_IMAGE=ghcr.io/leekiara1215/kiarabot-adapter-nonebot@sha256:<64 hex>
# KIARABOT_PANEL_IMAGE=ghcr.io/leekiara1215/kiarabot-panel@sha256:<64 hex>
# Host path of the 0600 control configuration mounted read-only into Core.
# KIARABOT_CONTROL_CONFIG_FILE=/etc/kiarabot/control.json
