# Export actual configured target properties, not a manually maintained dependency allowlist.
function(kiarabot_collect_targets DIRECTORY_PATH OUTPUT)
  get_property(LOCAL_TARGETS DIRECTORY "${DIRECTORY_PATH}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(CHILDREN DIRECTORY "${DIRECTORY_PATH}" PROPERTY SUBDIRECTORIES)
  foreach(CHILD IN LISTS CHILDREN)
    kiarabot_collect_targets("${CHILD}" CHILD_TARGETS)
    list(APPEND LOCAL_TARGETS ${CHILD_TARGETS})
  endforeach()
  set(${OUTPUT} "${LOCAL_TARGETS}" PARENT_SCOPE)
endfunction()

function(kiarabot_export_architecture_graph)
  kiarabot_collect_targets("${CMAKE_SOURCE_DIR}" ALL_TARGETS)
  set(GRAPH "{}")
  foreach(TARGET_NAME IN LISTS ALL_TARGETS)
    set(NODE "{}")
    foreach(PROPERTY TYPE LINK_LIBRARIES INTERFACE_LINK_LIBRARIES INCLUDE_DIRECTORIES
        INTERFACE_INCLUDE_DIRECTORIES SOURCES KIARABOT_REFERENCE)
      get_target_property(VALUE "${TARGET_NAME}" "${PROPERTY}")
      if(VALUE STREQUAL "VALUE-NOTFOUND")
        set(VALUE "")
      endif()
      set(VALUES "[]")
      set(INDEX 0)
      foreach(ITEM IN LISTS VALUE)
        string(REPLACE "\\" "\\\\" ESCAPED "${ITEM}")
        string(REPLACE "\"" "\\\"" ESCAPED "${ESCAPED}")
        string(JSON VALUES SET "${VALUES}" ${INDEX} "\"${ESCAPED}\"")
        math(EXPR INDEX "${INDEX} + 1")
      endforeach()
      string(JSON NODE SET "${NODE}" "${PROPERTY}" "${VALUES}")
    endforeach()
    string(JSON GRAPH SET "${GRAPH}" "${TARGET_NAME}" "${NODE}")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/architecture-targets.json" "${GRAPH}\n")
endfunction()
