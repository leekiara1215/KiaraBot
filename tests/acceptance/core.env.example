# Source only from the KiaraBot root. Replace all REPLACE_ values locally.
KIARABOT_ADAPTER_ID=nonebot-test
KIARABOT_ADAPTER_TOKEN=REPLACE_WITH_RANDOM_ADAPTER_TOKEN_AT_LEAST_32_CHARS
KIARABOT_ADAPTER_ACCOUNTS=REPLACE_WITH_BOT_QQ_NUMBER
KIARABOT_RUNTIME_DB="$PWD/data/t07b/core.db"
KIARABOT_PLUGIN_ID=event-observer
KIARABOT_PLUGIN_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_PLUGIN_TOKEN_32_CHARS
KIARABOT_PLUGIN_PERMISSIONS=message.read
KIARABOT_PLUGIN_EXECUTABLE="$PWD/sdk/python/.venv/bin/python"
KIARABOT_PLUGIN_MANIFEST="$PWD/plugins/event-observer/plugin.json"
KIARABOT_PLUGIN_PYTHONPATH="$PWD/sdk/python/src:$PWD/sdk/python/build/generated:$PWD/plugins/event-observer"
KIARABOT_MODEL_ENDPOINT='https://REPLACE_WITH_PROVIDER_HOST/v1/chat/completions'
KIARABOT_MODEL_NAME=REPLACE_WITH_PROVIDER_MODEL_NAME
KIARABOT_MODEL_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
