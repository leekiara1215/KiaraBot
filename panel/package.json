{
  "name": "kiarabot-control-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../api/openapi.yaml -o src/generated/openapi.d.ts && node scripts/generate-asyncapi.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "dev": "vite",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "postinstall": "npm run generate"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@asyncapi/modelina": "5.10.1",
    "@asyncapi/parser": "3.6.6",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "js-yaml": "4.3.2"
  }
}
